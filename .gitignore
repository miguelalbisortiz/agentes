# Dependencies (regenerable via npm install)
node_modules/
.opencode/node_modules/

# Session memory (machine-local, regenerable)
# Recovery state files (auto-generated, machine-local)
docs/state/*.json
docs/state/_archive/
# Auto-generated instinct files
docs/instincts/*.json

# Secrets
# Nota: setup-mcp escribe las credenciales de MCP en claro dentro de
# opencode.json, que SI se trackea (es la config del pack). Si has activado un
# MCP con secreto, revisa `git diff` antes de commitear. Lo de abajo no se sube.
.env
.env.*
*.pem
secrets.*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Timestamped backups (e.g. docs/PROJECT.md.bak.<ts> from refresh-project.js)
*.bak.*

# Hookify audit logs (machine-local, generated by .opencode/plugins/hookify.js)
.opencode/logs/

# --- Compat junctions (opencode 1.17.x) ---
# .opencode/agent -> .opencode/agents
# .opencode/skill -> .agents/skills
# Se crean en cada instalacion (init-opencode.ps1) y NUNCA se trackean:
# si git los indexa, `git add -A` traversa el junction y stagedea TODO el
# arbol de agents/skills duplicado (.opencode/agent/*.md, .opencode/skill/*).
.opencode/agent
.opencode/skill
.opencode/agent/
.opencode/skill/

# --- Notas de trabajo internas (no son parte de la biblioteca) ---
# El tracker de sesion vive solo en local: el repositorio publico contiene
# agents, commands y skills, no el cuaderno de anotaciones de quien lo mantiene.
PENDIENTES.md

# Informe comparativo de analisis: vive solo en local por decision del
# mantenedor (el repo es publico y el informe audita nuestras propias
# debilidades). Tiene que viajar SIEMPRE junto a SKIP_FILES en
# .opencode/bin/lint-docs.js: si solo esta aqui, local escanea 225 y CI 224.
docs/reports/2026-10-07_1313-ecc-vs-open.report.md

# Analisis de la importacion de ECC (que entro, que no y por que). Mismo
# contrato que lo anterior: SIEMPRE junto a SKIP_FILES en lint-docs.js.
ANALISIS-ECC.md
