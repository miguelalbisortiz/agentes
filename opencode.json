{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "share": "manual",
    "autoupdate": false,
    "snapshot": false,
    "instructions": [
        ".opencode/AGENTS.md"
    ],
    "permission": {
        "skill": "allow"
    },
    "tool_output": {
        "max_lines": 60,
        "max_bytes": 4096
    },
    "compaction": {
        "auto": true,
        "tail_turns": 4
    },
    "plugin": [
        "opencode-vibeguard",
        "opencode-pty",
        "@tarquinen/opencode-dcp"
    ],
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp@3.2.3"
            ]
        },
        "supabase": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@supabase/mcp-server@latest"
            ],
            "env": {
                "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
            }
        },
        "vercel": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@vercel/mcp-server@latest"
            ],
            "env": {
                "VERCEL_TOKEN": "${VERCEL_TOKEN}"
            }
        },
        "stripe": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@stripe/mcp-server@latest"
            ],
            "env": {
                "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
            }
        }
    }
}
