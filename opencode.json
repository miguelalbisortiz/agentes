{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "share": "manual",
    "update": "disable",
    "snapshots": false,
    "lsp": true,
    "instructions": [
        ".opencode/AGENTS.md"
    ],
    "permissions": [
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        }
    ],
    "tool_output": {
        "max_lines": 60,
        "max_bytes": 4096
    },
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 8000
        }
    },
    "mcp": {
        "servers": {
            "context7": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@upstash/context7-mcp@3.2.3"
                ]
            },
            "anydoc": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "mcp-server-anydoc@1.0.0"
                ]
            }
        }
    }
}
